# Copy to .env.local. Never commit .env.local.
# Local values: `npx supabase status -o env` after `npx supabase start`.

# Supabase → Project Settings → API. The publishable key (or the legacy anon
# key) is safe in the browser: RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The secret (service-role) key. Server only, never NEXT_PUBLIC_. Used solely by
# src/server/derived.ts to write standings and match results computed by the
# rules engine, and to move divisions between phases.
SUPABASE_SECRET_KEY=

# Enables reading PDF entry forms with Claude. Without it, PDF import is refused
# with guidance and CSV/XLSX still work.
ANTHROPIC_API_KEY=

# Where this app is served. Sign-in emails link back here, so it must also be
# listed under Supabase → Authentication → URL Configuration → Redirect URLs
# (e.g. http://localhost:3000/**). On Vercel leave it unset: the production
# domain is used automatically. Set it there only for a custom domain.
SITE_URL=http://localhost:3000
